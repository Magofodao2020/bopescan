      "rule_id": "f4c99b57-02c8-4e53-82d0-dba8bdc13dda",
      "collector": "evtx",
      "strength": "tamper",
      "state": "not_found",
      "retention": "Only clearings still recorded in the System log as it stands today. The log holds a limited window and overwrites its oldest records, and clearing the System log removes these records along with everything else — so nothing found here does not mean no log was ever cleared."
    },
